{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/app/azure-voting-app-dotnet/azure-vote/azure-vote/AzureVote.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/app/azure-voting-app-dotnet/azure-vote/azure-vote/AzureVote.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dev",
            "detail": "Run the app locally with hot reload (dotnet watch)",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/app/azure-voting-app-dotnet/azure-vote/azure-vote/AzureVote.csproj"
            ],
            "problemMatcher": "$msCompile",
            "isBackground": true
        },
        {
            "label": "docker: build & load image into Kind",
            "detail": "Builds the azure-vote-app-dotnet image and loads it into the local Kind cluster",
            "type": "shell",
            "command": "${workspaceFolder}/app/azure-voting-app-dotnet/build-and-load.sh",
            "problemMatcher": [],
            "group": "build"
        }
    ]
}